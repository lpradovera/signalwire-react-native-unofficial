package __PKG__.harness;

import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;
import android.os.Bundle;
import android.util.Log;

import io.invertase.firebase.messaging.ReactNativeFirebaseMessagingReceiver;

/**
 * DEVICE-SUITE BUILDS ONLY (added by apply-fcm-harness.sh; never in a shipped app).
 *
 * Stands in for Google Play services delivering a high-priority FCM data
 * message: builds the extras bundle GMS hands to the app's
 * com.google.android.c2dm.intent.RECEIVE receiver and passes it to React
 * Native Firebase's own receiver, so everything after the wire (foreground
 * event vs. headless task, the JS handlers, the package) is the real code.
 *
 *   adb shell am broadcast -n <app id>/<app id>.harness.SimulatedFcmReceiver \
 *     --es call_id c1 --es sw_from +15550001111 --es from_name Ada --es bridgeToken t1
 */
public class SimulatedFcmReceiver extends BroadcastReceiver {
  @Override
  public void onReceive(Context context, Intent intent) {
    Bundle wire = new Bundle();
    Bundle extras = intent.getExtras();
    if (extras != null) {
      for (String key : extras.keySet()) {
        Object value = extras.get(key);
        if (value != null) {
          wire.putString(key, String.valueOf(value));
        }
      }
    }
    // What GMS adds to every FCM delivery.
    wire.putString("from", "000000000000");
    wire.putString("google.message_id", "0:sim-" + System.currentTimeMillis());
    wire.putString("google.delivered_priority", "high");
    wire.putString("google.original_priority", "high");
    wire.putLong("google.sent_time", System.currentTimeMillis());
    wire.putInt("google.ttl", 60);

    Intent delivery = new Intent("com.google.android.c2dm.intent.RECEIVE");
    delivery.putExtras(wire);
    Log.i("SWHarness", "simulated FCM data message: " + wire.keySet());
    new ReactNativeFirebaseMessagingReceiver().onReceive(context, delivery);
  }
}

# Copy to suite.env (gitignored). See docs/device-testing.md.
ANDROID_SERIAL=emulator-5554
# The token server's env file: SIGNALWIRE_SPACE, SIGNALWIRE_PROJECT_ID,
# SIGNALWIRE_API_TOKEN, ALLOW_UNAUTHENTICATED_TOKENS=1, DEV_SUBSCRIBER_REFERENCE.
SW_ENV_FILE=../../server/.env
# The subscriber the app signs in as and the token server mints for
# (DEV_SUBSCRIBER_REFERENCE): one only tests use. suite.sh refuses rn-example,
# the example's default. Minting a token for a new reference creates it.
SW_SUBSCRIBER=/private/rn-devtest-<you>
# Run by the inbound test caller once answered; must send audio (play silence).
SW_INBOUND_URL=https://<space>.signalwire.com/relay-bins/<id>
# Dialled by outbound tests; must answer and send audio.
SW_TEST_DESTINATION=/private/rn-device-test

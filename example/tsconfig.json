{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Expo's base uses classic "node" resolution, which cannot see the
    // "exports" map — so @signalwire/react-native/audio and /callkit would not
    // resolve. Metro itself understands exports; this only realigns tsc.
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["**/*.ts", "**/*.tsx"]
}

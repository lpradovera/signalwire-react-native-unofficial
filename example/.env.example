# Copy to `.env` (gitignored) and set your own value.
#
# The application identifier used for both the iOS bundle identifier and the
# Android package name. It must be globally unique across Apple's ecosystem and
# registrable by your Apple Developer team, so it cannot be committed — pick
# something under a prefix your team controls.
#
# It must be valid on both platforms: letters, digits and dots only, each
# segment starting with a letter. iOS accepts hyphens and Android does not
# (com.acme-corp.app prebuilds for iOS and fails Android's package-name check),
# while Android accepts underscores and iOS does not.
#
# Read at config-evaluation time, so it must be set for `expo prebuild` and
# `expo run:ios`, not only at runtime.
SW_APP_ID=com.example.swrnexample

# Optional: the support server's /token endpoint. When set, the app fetches a
# subscriber token on launch instead of showing the paste-a-token screen.
#
# Use the machine's LAN address, not localhost — a real device cannot reach
# your Mac's loopback. The EXPO_PUBLIC_ prefix is required: it is what makes
# Expo inline the value into the bundle.
EXPO_PUBLIC_SW_TOKEN_URL=http://192.168.1.10:3000/token

# Push (the parked-caller flow in docs/push-setup.md). These go together:
# registering for push without a bridge address rings the device, and the
# answer then has nowhere to dial, so the app ends the call.
#   EXPO_PUBLIC_SW_DEVICES_URL=<server>/devices   register for VoIP / FCM push
#   EXPO_PUBLIC_SW_BRIDGE_ADDRESS=/private/bridge   dialled to join a parked caller
#   EXPO_PUBLIC_SW_SUBSCRIBER_REF=rn-example      the reference to request a
#                                                 token for; the device registers
#                                                 under the one the server answers
#                                                 with. A pasted token registers
#                                                 under the reference typed beside
#                                                 it, or not at all.

# Optional dev conveniences, all off unless set:
#   EXPO_PUBLIC_SW_AUTODIAL=<address>   dial it automatically on reaching Home
#   EXPO_PUBLIC_SW_DIAL_VIDEO=1         offer video when dialing, and video in
#                                       the native call UI (default is
#                                       audio-only: a sendonly video m-line to
#                                       an audio-only destination is accepted
#                                       and then never answered)
#   EXPO_PUBLIC_SW_WIRE_LOG=1           trace logging + every WebSocket frame,
#                                       including the SDP
#   EXPO_PUBLIC_SW_DEV_DIAL_AGAIN=<address>   a "Dial again" button on the call
#                                       screen that dials it mid-call: a second
#                                       call that holds the first (call
#                                       waiting), or is refused with
#                                       CallInProgressError in the
#                                       'endAndAccept' and 'single' modes
#   EXPO_PUBLIC_SW_CALL_WAITING=endAndAccept|single   the call-waiting mode
#                                       (default 'full': Hold & Accept, End &
#                                       Accept, swap)
#   EXPO_PUBLIC_SW_DEV_STATS=1          [DEVSTATS] log lines every 2 s: each
#                                       call's status, hold state and RTP
#                                       packet counters
#   EXPO_PUBLIC_SW_END_CALLS_ON_BACK=1  Back during a call ends it (default:
#                                       the call goes on, and its ongoing-call
#                                       notification brings the app back)
#   EXPO_PUBLIC_SW_CALLKIT=0            no native call UI: plain WebRTC calls,
#                                       outside CallKit and Telecom (on Android
#                                       the package's microphone foreground
#                                       service keeps the mic live in the
#                                       background)

# Android emulator only. The emulator does not inherit MagicDNS, so a tailnet
# hostname that resolves on the host fails on the device with
# "Network request failed". Map the port instead:
#   adb reverse tcp:3000 tcp:3000
# iOS keeps the hostname — a physical device is not on the emulator loopback.
EXPO_PUBLIC_SW_TOKEN_URL_ANDROID=http://localhost:3000/token
EXPO_PUBLIC_SW_DEVICES_URL_ANDROID=http://localhost:3000/devices

# Give Android its own subscriber so testing it does not ring the iOS device.
EXPO_PUBLIC_SW_SUBSCRIBER_REF_ANDROID=rn-android

# Copy to `.env` (gitignored) and set your own value.
#
# The application identifier used for both the iOS bundle identifier and the
# Android package name. It must be globally unique across Apple's ecosystem and
# registrable by your Apple Developer team, so it cannot be committed — pick
# something under a prefix your team controls.
#
# Read at config-evaluation time, so it must be set for `expo prebuild` and
# `expo run:ios`, not only at runtime.
SW_APP_ID=com.example.swrnexample

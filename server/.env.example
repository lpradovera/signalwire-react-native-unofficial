# Copy to `.env` (gitignored) and fill in. Read automatically by `npm run dev`.

# --- Server ----------------------------------------------------------------
# Bearer token for /devices, /notify and /webhooks/signalwire. Unset, anyone
# can register a device under any user, list every token and push to anyone.
# API_TOKEN=
# PORT=3000
# DEVICE_STORE_PATH=./.data/devices.json

# --- Subscriber tokens (POST /token) -------------------------------------
# Also used to end a parked caller (calling.end) when the device hangs up or
# the user declines.
SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=

# Development only: mints a token for ANY caller, no authentication.
# Replace `authenticateCaller` in src/routes/token.ts before deploying.
ALLOW_UNAUTHENTICATED_TOKENS=1
# The development /token stub's default reference, AND the park's fallback
# subscriber: with it set, every parked call that ?subscriber= and PARK_ROUTES
# do not resolve rings this user.
DEV_SUBSCRIBER_REFERENCE=rn-example

# --- Push sending (optional; needed for checklist items 5-7) --------------
# iOS (VoIP push through APNs). One .p8 key covers sandbox and production.
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_P8_KEY=
# IOS_BUNDLE_ID=

# Android (FCM HTTP v1). From the Firebase service-account JSON.
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# --- Inbound parked-caller flow ------------------------------------------
# Public URL SignalWire can reach (a tunnel in development). Builds the
# bridge's status_url, without which a parked caller is left up when the
# device hangs up, and is the URL request signatures are checked against.
# PUBLIC_URL=https://<host>.<tailnet>.ts.net

# The space's Signing Key. Set, /swml/park, /swml/bridge and
# /swml/bridge/status refuse requests SignalWire did not sign; unset, anyone
# who can reach this server can ring any subscriber. Needs PUBLIC_URL.
# SIGNALWIRE_SIGNING_KEY=

# Dialled destination -> subscriber. Required once a phone number points at
# the park resource: nothing in an E.164 number names a user.
# PARK_ROUTES=+15551234567:rn-example,+15559998888:other-user

# Your own ringback recording, replacing the generated ring:15.0:us tone,
# and its length in seconds (required with it: the park repeats the
# recording to fill its 60 s). <PUBLIC_URL>/swml/ringback serves a 6 s one.
# PARK_RINGBACK_URL=
# PARK_RINGBACK_SECONDS=6

# Copy to `.env` (gitignored) and fill in. Read automatically by `npm run dev`.

# --- Subscriber tokens (POST /token) -------------------------------------
SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=

# Development only: mints a token for ANY caller, no authentication.
# Replace `authenticateCaller` in src/routes/token.ts before deploying.
ALLOW_UNAUTHENTICATED_TOKENS=1
DEV_SUBSCRIBER_REFERENCE=rn-example

# --- Push sending (optional; needed for checklist items 5-7) --------------
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_P8_KEY=
# IOS_BUNDLE_ID=

# Bearer token for every route except /health. Unset = unauthenticated.
API_TOKEN=change-me
PORT=3000
DEVICE_STORE_PATH=./.data/devices.json

# --- iOS (PushKit / APNs) ---
# One .p8 key covers alert + VoIP, sandbox + production.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_P8_KEY=
# WITHOUT the .voip suffix — the sender appends it.
IOS_BUNDLE_ID=com.signalwire.rnexample

# --- Android (FCM) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

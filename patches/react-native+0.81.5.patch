+// UIKit's default paragraph style, whatever its line break mode and resolved writing direction: what UIKit gives text
+// typed into a field whose text attributes set no paragraph style.
+static BOOL RCTIsDefaultParagraphStyle(id value)
+{
+  if (![value isKindOfClass:[NSParagraphStyle class]]) {
+    return NO;
+  }
+  NSParagraphStyle *style = value;
+  NSMutableParagraphStyle *defaultStyle = [NSParagraphStyle.defaultParagraphStyle mutableCopy];
+  defaultStyle.lineBreakMode = style.lineBreakMode;
+  defaultStyle.baseWritingDirection = style.baseWritingDirection;
+  return [style isEqual:defaultStyle];
+}
+
+// YES if the field shows `attributedString`: the same characters, every attribute the string sets has the same value
+// in the field, and every attribute only the field has is a default (the view's default text attributes, or UIKit's
+// default paragraph style). An attribute that JS removes is not a default, so that change is still written.
+- (BOOL)_fieldAlreadyShows:(NSAttributedString *)attributedString
+{
+  NSAttributedString *fieldText = _backedTextInputView.attributedText;
+  if (![attributedString.string isEqualToString:fieldText.string]) {
+    return NO;
+  }
+  NSDictionary<NSAttributedStringKey, id> *defaults = _backedTextInputView.defaultTextAttributes;
+  NSUInteger index = 0;
+  while (index < attributedString.length) {
+    NSRange range;
+    NSRange fieldRange;
+    NSDictionary<NSAttributedStringKey, id> *attributes = [attributedString attributesAtIndex:index
+                                                                               effectiveRange:&range];
+    NSDictionary<NSAttributedStringKey, id> *fieldAttributes = [fieldText attributesAtIndex:index
+                                                                             effectiveRange:&fieldRange];
+    for (NSAttributedStringKey key in attributes) {
+      if (![attributes[key] isEqual:fieldAttributes[key]]) {
+        return NO;
+      }
+    }
+    for (NSAttributedStringKey key in fieldAttributes) {
+      id value = fieldAttributes[key];
+      if (attributes[key] == nil && ![value isEqual:defaults[key]] &&
+          !([key isEqualToString:NSParagraphStyleAttributeName] && RCTIsDefaultParagraphStyle(value))) {
+        return NO;
+      }
+    }
+    index = MIN(NSMaxRange(range), NSMaxRange(fieldRange));
+  }
+  return YES;
+}

{
  "name": "@signalwire/react-native",
  "version": "0.1.0",
  "description": "React Native support for the SignalWire JS SDK",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    },
    "./callkit": {
      "import": { "types": "./dist/callkit.d.mts", "default": "./dist/callkit.mjs" },
      "require": { "types": "./dist/callkit.d.ts", "default": "./dist/callkit.js" }
    },
    "./audio": {
      "import": { "types": "./dist/audio.d.mts", "default": "./dist/audio.mjs" },
      "require": { "types": "./dist/audio.d.ts", "default": "./dist/audio.js" }
    },
    "./polyfills": {
      "import": { "types": "./dist/polyfills.d.mts", "default": "./dist/polyfills.mjs" },
      "require": { "types": "./dist/polyfills.d.ts", "default": "./dist/polyfills.js" }
    },
    "./app.plugin.js": "./app.plugin.js"
  },
  "//typesVersions": "Lets subpath types resolve under TypeScript's classic \"node\" moduleResolution, which Expo's tsconfig.base still sets. Without this, consumers must override moduleResolution to see /callkit, /audio and /polyfills types.",
  "typesVersions": {
    "*": {
      "callkit": ["./dist/callkit.d.ts"],
      "audio": ["./dist/audio.d.ts"],
      "polyfills": ["./dist/polyfills.d.ts"]
    }
  },
  "//sideEffects": "NOT false. The polyfills entry exists purely for its side effects; marking the package side-effect-free lets bundlers drop it, which breaks the SDK at import time.",
  "sideEffects": ["./dist/polyfills.js", "./dist/polyfills.mjs"],
  "engines": { "node": ">=18" },
  "files": ["dist", "app.plugin.js"],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": ["signalwire", "react-native", "webrtc", "callkit", "voip"],
  "peerDependencies": {
    "@expo/config-plugins": "^9.0.0",
    "@react-native-async-storage/async-storage": ">=2.0.0",
    "@react-native-community/netinfo": ">=11.0.0",
    "@signalwire/js": "^4.0.0-rc.2",
    "react": ">=18.2.0",
    "react-native": ">=0.76.0",
    "react-native-callkeep": ">=4.3.0",
    "react-native-get-random-values": ">=1.11.0",
    "react-native-incall-manager": ">=4.2.0",
    "react-native-url-polyfill": ">=2.0.0",
    "react-native-webrtc": ">=124.0.0",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": { "optional": true },
    "@react-native-community/netinfo": { "optional": true },
    "react-native-callkeep": { "optional": true },
    "react-native-incall-manager": { "optional": true }
  },
  "devDependencies": {
    "@expo/config-plugins": "^9.0.0",
    "@expo/config-types": "^52.0.0",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@signalwire/js": "^4.0.0-rc.2",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.18",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-callkeep": "^4.3.16",
    "react-native-get-random-values": "^1.11.0",
    "react-native-incall-manager": "^4.2.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-webrtc": "^124.0.5",
    "react-test-renderer": "18.3.1",
    "rxjs": "^7.8.2",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}

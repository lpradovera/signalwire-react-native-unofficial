{
  "name": "@signalwire/react-native",
  "version": "0.1.0",
  "description": "React Native support for the SignalWire JS SDK",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./callkit": {
      "import": {
        "types": "./dist/callkit.d.mts",
        "default": "./dist/callkit.mjs"
      },
      "require": {
        "types": "./dist/callkit.d.ts",
        "default": "./dist/callkit.js"
      }
    },
    "./audio": {
      "import": {
        "types": "./dist/audio.d.mts",
        "default": "./dist/audio.mjs"
      },
      "require": {
        "types": "./dist/audio.d.ts",
        "default": "./dist/audio.js"
      }
    },
    "./polyfills": {
      "import": {
        "types": "./dist/polyfills.d.mts",
        "default": "./dist/polyfills.mjs"
      },
      "require": {
        "types": "./dist/polyfills.d.ts",
        "default": "./dist/polyfills.js"
      }
    },
    "./app.plugin.js": "./app.plugin.js",
    "./ringing": {
      "import": {
        "types": "./dist/ringing.d.mts",
        "default": "./dist/ringing.mjs"
      },
      "require": {
        "types": "./dist/ringing.d.ts",
        "default": "./dist/ringing.js"
      }
    }
  },
  "//typesVersions": "Lets subpath types resolve under TypeScript's classic \"node\" moduleResolution, which Expo's tsconfig.base still sets. Without this, consumers must override moduleResolution to see /callkit, /audio and /polyfills types.",
  "typesVersions": {
    "*": {
      "callkit": [
        "./dist/callkit.d.ts"
      ],
      "audio": [
        "./dist/audio.d.ts"
      ],
      "polyfills": [
        "./dist/polyfills.d.ts"
      ],
      "ringing": [
        "./dist/ringing.d.ts"
      ]
    }
  },
  "//sideEffects": "NOT false. The polyfills entry exists purely for its side effects; marking the package side-effect-free lets bundlers drop it, which breaks the SDK at import time.",
  "sideEffects": [
    "./dist/polyfills.js",
    "./dist/polyfills.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "app.plugin.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [
    "signalwire",
    "react-native",
    "webrtc",
    "callkit",
    "voip"
  ],
  "peerDependencies": {
    "@expo/config-plugins": "^9.0.0 || ^10.0.0 || ^54.0.0",
    "@react-native-async-storage/async-storage": ">=1.23.0",
    "@react-native-community/netinfo": ">=11.0.0",
    "@react-native-firebase/app": ">=22.0.0",
    "@react-native-firebase/messaging": ">=22.0.0",
    "@signalwire/js": "^4.0.0-rc.2",
    "react": ">=18.2.0",
    "react-native": ">=0.76.0",
    "react-native-callkeep": ">=4.3.0",
    "react-native-get-random-values": ">=1.11.0",
    "react-native-incall-manager": ">=4.2.0",
    "react-native-url-polyfill": ">=2.0.0",
    "react-native-webrtc": ">=124.0.0",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    },
    "@react-native-community/netinfo": {
      "optional": true
    },
    "@react-native-firebase/app": {
      "optional": true
    },
    "@react-native-firebase/messaging": {
      "optional": true
    },
    "react-native-callkeep": {
      "optional": true
    },
    "react-native-incall-manager": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "^54.0.5",
    "@expo/config-types": "^54.0.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@signalwire/js": "^4.0.0-rc.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-callkeep": "^4.3.16",
    "react-native-get-random-values": "^1.11.0",
    "react-native-incall-manager": "^4.2.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-webrtc": "^124.0.5",
    "rxjs": "^7.8.2",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "test-renderer": "^1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lpradovera/signalwire-react-native-unofficial.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/lpradovera/signalwire-react-native-unofficial/issues"
  },
  "homepage": "https://github.com/lpradovera/signalwire-react-native-unofficial#readme",
  "dependencies": {
    "@signalwire/react": "^0.1.0"
  }
}

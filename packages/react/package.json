{
  "name": "@signalwire/react",
  "version": "0.1.0",
  "description": "Universal React bindings for the SignalWire JS SDK — works in the browser and in React Native",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [
    "signalwire",
    "react",
    "webrtc",
    "voip",
    "hooks"
  ],
  "peerDependencies": {
    "@signalwire/js": "^4.0.0-rc.2",
    "react": ">=18.2.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@signalwire/js": "^4.0.0-rc.2",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}

{
  "name": "@signalwire/react-native-ui",
  "version": "0.1.0",
  "description": "React Native call UI components for the SignalWire SDK",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [
    "signalwire",
    "react-native",
    "ui",
    "webrtc",
    "voip"
  ],
  "peerDependencies": {
    "@signalwire/js": "^4.0.0-rc.2",
    "@signalwire/react": "^0.1.0",
    "@signalwire/react-native": "^0.1.0",
    "react": ">=18.2.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@signalwire/js": "^4.0.0-rc.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "rxjs": "^7.8.2",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "test-renderer": "^1.2.0"
  }
}

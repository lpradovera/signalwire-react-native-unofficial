node_modules/
dist/
coverage/
*.log

# Expo / RN generated native projects. Regenerated by `expo prebuild`.
# NOTE: if you adopt EAS Build you will likely want to commit these instead —
# prebuild wipes hand edits to AppDelegate. See docs/push-setup.md.
.expo/
example/ios/
example/android/
example/.expo-export-check/

# Server runtime state and secrets
server/.data/
.env
.env.local

.DS_Store

# Debug captures: wire logs contain subscriber tokens and the app identifier
wire-log*.txt
*.wire-log

# Internal planning artifacts — kept locally, never published
docs/superpowers/

# Firebase project files: per-project, and the service account key they pair
# with is a send-as-your-project credential. Never committed.
google-services.json
GoogleService-Info.plist
